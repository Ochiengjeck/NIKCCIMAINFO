# Spaceship Web Hosting Pro production template.
# Copy to .env on the server, then fill in the (set) placeholders.
# See docs/SPACESHIP_DEPLOYMENT.md for the end-to-end setup.

APP_NAME=NiKCCIMA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nikccima.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL provided by cPanel. DB name and user carry the cPanel account prefix.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Shared hosting has no persistent worker, so notifications send synchronously.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# SMTP via Spacemail (already provisioned on the account).
MAIL_MAILER=smtp
MAIL_HOST=mail.spacemail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@nikccima.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_REDIRECT_URL=/admin/dashboard
